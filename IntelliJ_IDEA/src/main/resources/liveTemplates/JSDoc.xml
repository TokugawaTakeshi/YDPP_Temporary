<templateSet group="JSDoc [YDPP]">
  <template name="@type" value="/** @type { $END$ } */" description="@type (JDoc) - [YDPP]" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JAVA_SCRIPT" value="true" />
    </context>
  </template>
  <template name="@description" value="/**&#10; * @description $END$&#10; */&#10;/** @description */" description="@description (JDoc) - [YDPP]" toReformat="false" toShortenFQNames="true">
    <context>
      <option name="JS_EXPRESSION" value="true" />
      <option name="TS_EXPRESSION" value="true" />
    </context>
  </template>
</templateSet>