  /* ━━━ ID ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
  export type ID = string;
  export namespace ID {

    export const NAME: string = "ID";
    export const TYPE: StringConstructor = String;
    export const REQUIRED: boolean = true;
    export const MINIMAL_ONE_BYTE_CHARACTERS_COUNT: number = 2;
    export const MAXIMAL_ONE_BYTE_CHARACTERS_COUNT: number = 128;

    export function isValid(potentialID: unknown): boolean {
      return typeof potentialID === "string" &&
          potentialID.length >= MINIMAL_CHARACTERS_COUNT &&
          potentialID.length <= MAXIMAL_CHARACTERS_COUNT;
    }

  }

