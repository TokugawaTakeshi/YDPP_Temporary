type ${NAME} = {

  ID: ${NAME}.ID;

  exampleNumericRequiredProperty: number;
  exampleNumericOptionalProperty?: number;

  exampleStringRequiredProperty: string;
  exampleStringOptionalProperty?: string;

  exampleBooleanProperty: boolean;

